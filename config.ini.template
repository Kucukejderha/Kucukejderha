; Bu bir yapılandırma dosyası şablonudur.
; Lütfen bu dosyanın adını "config.ini" olarak değiştirin ve kendi bilgilerinizi girin.
; Türkçe karakter sorunu yaşamamak için dosyayı UTF-8 formatında kaydettiğinizden emin olun.

[DATABASE]
; MS SQL Sunucunuzun ağ üzerindeki IP adresi veya adı
server = 192.168.1.100
; Bağlanılacak veritabanının adı
database = TicariDB
; Veritabanı bağlantısı için kullanıcı adı
username = sa
; Veritabanı bağlantısı için şifre
password = YourPassword123
; Genellikle bu sürücü işe yarar. Eğer SQL Server sürümünüz farklıysa veya
; sunucunuzda başka bir ODBC sürücüsü kuruluysa, onu buraya yazmanız gerekebilir.
; Kurulu sürücüleri Windows'ta "ODBC Data Sources" uygulamasından görebilirsiniz.
driver = {ODBC Driver 17 for SQL Server}

[FTP]
; urunler.json dosyasının yükleneceği web sunucusunun adresi (örn: rotaniz.com)
host = ftp.example.com
; Genellikle 21'dir. Farklı bir port kullanıyorsanız değiştirin.
port = 21
; FTP kullanıcı adınız
username = your_ftp_username
; FTP şifreniz
password = YourFtpPassword456
; Dosyanın web sunucusunda yükleneceği yol.
; Genellikle public_html veya www klasörünün içindeki bir yoldur.
; Örneğin, sayim uygulamanızın olduğu klasör: /public_html/sayim
remote_path = /path/to/your/sayim/folder
